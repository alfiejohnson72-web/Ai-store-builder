# App-level token (Basic Information > App-Level Tokens, scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# Bot token (xoxb-): the bot replies to your commands in Bot Control
SLACK_BOT_TOKEN=xoxb-...
# YOUR user token (xoxp-): the "T" replies are posted as you
SLACK_USER_TOKEN=xoxp-...
# Your Slack member ID (profile > ... > Copy member ID). Only you can command the bot.
CLAIM_USER_ID=U0123456789
# Channel ID of your private "Bot Control" channel
CONTROL_CHANNEL=C0123456789
# Optional: initial watched channel IDs (or just use `watch #channel` in Bot Control)
CLAIM_CHANNELS=
# Optional regex: only messages matching it are claimed as leads
CLAIM_MATCH=
# Optional: name of the app that posts your lead alerts (default AIBot)
LEAD_BOT_NAME=
# Optional: 0 (default) = reply the instant the lead arrives; e.g. 800 = the reply lands about 800ms after the lead.
# Can also be changed any time in Bot Control with: delay 800 / delay instant / delay default
REPLY_DELAY_MS=
