# App-level token (Basic Information > App-Level Tokens, scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# YOUR user token (OAuth > User Token Scopes: chat:write) - replies are posted as you
SLACK_USER_TOKEN=xoxp-...
# Your Slack member ID (profile > ... > Copy member ID)
CLAIM_USER_ID=U0123456789
# Comma-separated channel IDs to watch (leave empty to watch every channel the bot is in)
CLAIM_CHANNELS=
# Text posted in the thread
CLAIM_TEXT=Claimed ✋ I'm on it.
